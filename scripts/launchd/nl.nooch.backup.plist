<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  NoochVille back-up: elke dag een snapshot van prod data/ naar ~/NoochVille-backups (scripts/backup_mac.sh).

  Installeren (eenmalig, op Stefans Mac) — een VASTE KOPIE van de twee scripts buiten de repo, zodat
  de back-up niet afhangt van welke branch er uitgecheckt is:
    mkdir -p ~/NoochVille-backups/bin
    cp scripts/backup_mac.sh scripts/backup_herstel_toets.py ~/NoochVille-backups/bin/
    cp scripts/launchd/nl.nooch.backup.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/nl.nooch.backup.plist
  Na een wijziging aan de scripts: opnieuw kopiëren.
  Weghalen:
    launchctl unload ~/Library/LaunchAgents/nl.nooch.backup.plist && rm ~/Library/LaunchAgents/nl.nooch.backup.plist

  Sliep de Mac om 07:15, dan draait launchd hem bij het wakker worden — een gemiste dag wordt ingehaald,
  niet overgeslagen.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>nl.nooch.backup</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/stefanwobben/NoochVille-backups/bin/backup_mac.sh</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>NOOCH_REPO</key>
        <string>/Users/stefanwobben/noochville</string>
    </dict>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>7</integer>
        <key>Minute</key>
        <integer>15</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/stefanwobben/NoochVille-backups/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/stefanwobben/NoochVille-backups/launchd.err.log</string>
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
